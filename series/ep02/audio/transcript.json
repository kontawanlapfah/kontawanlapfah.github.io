[
 {
  "start": 0.155,
  "end": 2.144,
  "text": "กลิ่นขนมปัง ทำให้ลูกสาวผมเต"
 },
 {
  "start": 3.146,
  "end": 6.662,
  "text": "และนั่นคือสิ่งที่ทำให้การประสินใจครั้งนี้ยาก"
 },
 {
  "start": 7.437,
  "end": 8.872,
  "text": "ผมไม่ได้รับขนุมปังก้อนนั้น"
 },
 {
  "start": 9.391,
  "end": 10.352,
  "text": "ผมถาม Harries Wuerk"
 },
 {
  "start": 10.728,
  "end": 11.369,
  "text": "เขาคือใคร"
 },
 {
  "start": 12.033,
  "end": 13.122,
  "text": "Harris หัวรอ บาว"
 },
 {
  "start": 13.631,
  "end": 15.822,
  "text": "เขาคือคนที่ทุกคนรอคอยอย่างไรอดัม"
 },
 {
  "start": 16.351,
  "end": 17.818,
  "text": "เขาเลี้ยนดูคนที่เชื่อเขา"
 },
 {
  "start": 18.404,
  "end": 19.813,
  "text": "คำพูดนั้นทำให้ผมขนลุก"
 },
 {
  "start": 20.488,
  "end": 22.059,
  "text": "ผมนึกถึงข้อความเสียงของแม่"
 },
 {
  "start": 22.318,
  "end": 23.752,
  "text": "และ 3 อายาที่ผมท่องได้"
 },
 {
  "start": 24.24,
  "end": 25.57,
  "text": "ต้องต้องบางนิมาจากฆาว"
 },
 {
  "start": 25.94,
  "end": 27.351,
  "text": "บ้านผมรับไม่ได้หรอกฮาริส"
 },
 {
  "start": 27.864,
  "end": 29.622,
  "text": "แว้วตาของเพื่อนผมเปลี่ยนไปทันที"
 },
 {
  "start": 30.118,
  "end": 31.921,
  "text": "เขาว่างขนมปังลงบนทรณีประตู"
 },
 {
  "start": 32.411,
  "end": 33.232,
  "text": "แกจะปล่อยให้ลูกอด"
 },
 {
  "start": 33.354,
  "end": 34.375,
  "text": "ตายเพราะความดือเหรอ"
 },
 {
  "start": 34.846,
  "end": 37.061,
  "text": "ผมปิดประตูอย่างชาๆ ผ่านช่องประตู"
 },
 {
  "start": 37.644,
  "end": 38.994,
  "text": "ผมเห็นเขายือนนิ่งอยู่นาน"
 },
 {
  "start": 39.301,
  "end": 40.727,
  "text": "ก่อนจะเดินหายไปในความมืด"
 },
 {
  "start": 41.317,
  "end": 41.921,
  "text": "ลัสแมนลีกลัก"
 },
 {
  "start": 42.048,
  "end": 43.171,
  "text": "ก็ดังคืนข้างลังผม"
 },
 {
  "start": 43.714,
  "end": 44.286,
  "text": "บาบา"
 },
 {
  "start": 44.711,
  "end": 45.823,
  "text": "หนูได้กลิ่นขนมปัง"
 },
 {
  "start": 46.327,
  "end": 47.578,
  "text": "ผมกอดหวาไว้นั่น"
 },
 {
  "start": 47.835,
  "end": 48.752,
  "text": "และไม่กลาปอบลูก"
 },
 {
  "start": 49.364,
  "end": 50.312,
  "text": "เช้าวันต่อมา"
 },
 {
  "start": 50.442,
  "end": 51.886,
  "text": "ผมไปหาชายชายาที่มัสยิต"
 },
 {
  "start": 52.37,
  "end": 53.261,
  "text": "ทั้งฝังควมล้าจัก"
 },
 {
  "start": 53.444,
  "end": 54.071,
  "text": "แล้วบอกว่า"
 },
 {
  "start": 54.466,
  "end": 57.067,
  "text": "ทันนบี สาลัลล่าวัลัย วะสลัม"
 },
 {
  "start": 57.504,
  "end": 58.968,
  "text": "ใครได้ยินข่าวของดัสยาน"
 },
 {
  "start": 59.211,
  "end": 60.371,
  "text": "ให้อยู่ให้ห่านจักเขา"
 },
 {
  "start": 60.816,
  "end": 64.018,
  "text": "เพราะจะมีคนที่ไปหาเขาโดยคิดว่าตัวเองสั"
 },
 {
  "start": 64.393,
  "end": 65.184,
  "text": "แต่สุดท้ายกลับ"
 },
 {
  "start": 65.349,
  "end": 65.952,
  "text": "ตามเขาไป"
 },
 {
  "start": 66.252,
  "end": 67.994,
  "text": "เพราะสิ่งกลุ่มเครือที่เขาทำให"
 },
 {
  "start": 68.5,
  "end": 69.586,
  "text": "แล้วท่านก็จับมือผม"
 },
 {
  "start": 69.993,
  "end": 71.631,
  "text": "ทอง 10 อายาให้ครบนะอดำ"
 },
 {
  "start": 72.044,
  "end": 74.654,
  "text": "และอย่าลืมขอความคุ้มครองจากฟิตนัก"
 },
 {
  "start": 74.928,
  "end": 76.616,
  "text": "ทุกครั้งก่อนให้สลาเมลมาส"
 },
 {
  "start": 77.074,
  "end": 78.856,
  "text": "คืนนั้นผมท่องได้ห้าอัยะ"
 },
 {
  "start": 79.341,
  "end": 80.298,
  "text": "ช้าววันต่อมา"
 },
 {
  "start": 80.443,
  "end": 81.158,
  "text": "ผมละหมาตรซุป"
 },
 {
  "start": 81.462,
  "end": 82.822,
  "text": "แล้วนั่งทองเอลกฟีต่อ."
 },
 {
  "start": 83.29,
  "end": 84.213,
  "text": "ผมเงื่อยน่าขึ้น"
 },
 {
  "start": 84.585,
  "end": 86.739,
  "text": "ดวงอธิตย์อยู่เหนือหลังคาบ้าน"
 },
 {
  "start": 87.206,
  "end": 88.449,
  "text": "ผมท่องต่ออีกนาน"
 },
 {
  "start": 89.03,
  "end": 91.392,
  "text": "นาลิกาข้อมือของผมเดินไปแล้ว 9 ชั่"
 },
 {
  "start": 91.699,
  "end": 93.238,
  "text": "แต่ดวงอาทิตยังอยู่ตรงที่เด"
 },
 {
  "start": 93.486,
  "end": 94.933,
  "text": "ไม่ขยับเลยแม้แต่นิดเดียว"
 },
 {
  "start": 95.431,
  "end": 96.714,
  "text": "เกิดอะไรขึ้นกับทองฟ้า?"
 },
 {
  "start": 97.266,
  "end": 98.631,
  "text": "และถ้าดวงอาชิตย์ไม่ตกอ"
 },
 {
  "start": 99.023,
  "end": 100.732,
  "text": "ผมจะรู้ได้อย่างไรว่าเมื่อไหร่ต"
 },
 {
  "start": 101.239,
  "end": 104.127,
  "text": "คุณคิดว่าอดำตัดสินใจถูกไหมที่ปิ"
 },
 {
  "start": 104.546,
  "end": 105.407,
  "text": "คอมเมนต์ บอกกันด้วย"
 },
 {
  "start": 105.667,
  "end": 106.985,
  "text": "แล้วกดติดตามและแชร์ไว้"
 },
 {
  "start": 107.436,
  "end": 107.99,
  "text": "ตอนหน้า"
 },
 {
  "start": 108.15,
  "end": 110.066,
  "text": "ท้องฟ้าจะไม่เหมือนเดิมอีกต่อไป"
 }
]