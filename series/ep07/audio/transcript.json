[
 {
  "start": 0.0,
  "end": 1.774,
  "text": "ข้างหนึ่งคือแม่น้ำใสเย็น"
 },
 {
  "start": 2.303,
  "end": 4.523,
  "text": "อีกข้างคือกองไฟที่ลุกทวมหัว"
 },
 {
  "start": 5.147,
  "end": 7.33,
  "text": "และผมกำลังจะพาลูกเดินเข้าไปในกอง"
 },
 {
  "start": 7.95,
  "end": 9.655,
  "text": "หาริสไม่ได้พาพวกเขามาจับผม"
 },
 {
  "start": 10.107,
  "end": 11.669,
  "text": "ตอนที่จะหาลลากเราออกจากบ้าน"
 },
 {
  "start": 12.005,
  "end": 13.435,
  "text": "เขาเดียวมากระ 10 ข้างหูผม"
 },
 {
  "start": 13.914,
  "end": 15.62,
  "text": "ฉันเพยามขี่ชื่อแกออกแล้ว"
 },
 {
  "start": 15.8,
  "end": 16.124,
  "text": "แม่ม"
 },
 {
  "start": 16.822,
  "end": 18.084,
  "text": "แต่พวกมันมีรายชื่ออีกชุด"
 },
 {
  "start": 18.626,
  "end": 20.638,
  "text": "เสียงของเขาสั่นเหมือนคนจะร้องให้"
 },
 {
  "start": 21.234,
  "end": 23.025,
  "text": "พวกเราถูกพาไปที่ลานกลางเมือง"
 },
 {
  "start": 23.386,
  "end": 25.255,
  "text": "ปรงหน้ามีสองสิ่งตั้งอยู่เคียงก"
 },
 {
  "start": 25.683,
  "end": 27.346,
  "text": "แม่น้ำที่ใสเย็นหน้าดื่ม"
 },
 {
  "start": 27.683,
  "end": 29.893,
  "text": "และก่องไฟที่ร้อนจนผิวหน้าผมแสบ"
 },
 {
  "start": 30.39,
  "end": 31.478,
  "text": "เสียงประกาศดังขึ้น"
 },
 {
  "start": 31.865,
  "end": 32.479,
  "text": "คลายชื่อ!"
 },
 {
  "start": 32.669,
  "end": 33.578,
  "text": "คาวไปนายมันมัน"
 },
 {
  "start": 33.989,
  "end": 34.715,
  "text": "ครับ แด้ แสน"
 },
 {
  "start": 34.99,
  "end": 35.83,
  "text": "ขอบไปนี้ไฟ!"
 },
 {
  "start": 36.322,
  "end": 38.596,
  "text": "คนข้างหน้าผมวิ่งเข้าหาแม่น้ำอย่าง"
 },
 {
  "start": 39.048,
  "end": 39.321,
  "text": "ผมหลับ"
 },
 {
  "start": 39.469,
  "end": 39.789,
  "text": "ตา"
 },
 {
  "start": 39.96,
  "end": 41.199,
  "text": "นึกถึงคำของชัยยา"
 },
 {
  "start": 41.632,
  "end": 43.419,
  "text": "สิ่งที่เขาเรียบว่านน้ำคือไ"
 },
 {
  "start": 43.872,
  "end": 45.954,
  "text": "และสิ่งที่เขาเรียบว่าไฟคือน้ำ"
 },
 {
  "start": 46.392,
  "end": 47.159,
  "text": "คลับเจ้าค่อย จริงห"
 },
 {
  "start": 47.436,
  "end": 48.728,
  "text": "ให้เลือกสิ่งที่เห็นเป็นไฟ"
 },
 {
  "start": 49.291,
  "end": 50.395,
  "text": "ผมอุ่มหาวาขึ้น"
 },
 {
  "start": 50.68,
  "end": 51.867,
  "text": "จับมือเซามาไว้แน่น"
 },
 {
  "start": 52.105,
  "end": 53.15,
  "text": "ลวรอยมทางอลกฟ"
 },
 {
  "start": 53.654,
  "end": 54.495,
  "text": "อัยที่นุม"
 },
 {
  "start": 54.827,
  "end": 55.439,
  "text": "ที่หา"
 },
 {
  "start": 55.759,
  "end": 56.122,
  "text": "T. จัด"
 },
 {
  "start": 56.51,
  "end": 57.06,
  "text": "แล้วอายาทิบ"
 },
 {
  "start": 57.219,
  "end": 57.452,
  "text": "แบท"
 },
 {
  "start": 57.776,
  "end": 58.613,
  "text": "เก้าและสิบ"
 },
 {
  "start": 58.888,
  "end": 60.087,
  "text": "ที่ผมท่องผิดมาตลอด"
 },
 {
  "start": 60.343,
  "end": 62.251,
  "text": "กลับไหลออกมาจากปากผมยังไม่ติดค"
 },
 {
  "start": 62.666,
  "end": 63.576,
  "text": "ครบสิบอาญา"
 },
 {
  "start": 63.953,
  "end": 65.042,
  "text": "เป็นครั้งแรดในชีวิต"
 },
 {
  "start": 65.495,
  "end": 66.877,
  "text": "ผมก้าวเข้าไปในเปลลย์ไฟ"
 },
 {
  "start": 67.213,
  "end": 68.603,
  "text": "ความร้อนพุ่งเขาใส่หน้า"
 },
 {
  "start": 68.828,
  "end": 70.341,
  "text": "หวาสุขหน้ากับอกผม"
 },
 {
  "start": 70.56,
  "end": 72.145,
  "text": "ซ้อมาบีบมือผมแน่นจนเจ็บ"
 },
 {
  "start": 72.534,
  "end": 73.963,
  "text": "และทุกอย่างก็ขาวพลน"
 },
 {
  "start": 74.395,
  "end": 76.389,
  "text": "สิ่งที่รอเราอยู่ในกองไฟนั้นคือ"
 },
 {
  "start": 76.789,
  "end": 77.358,
  "text": "ลหارس"
 },
 {
  "start": 77.612,
  "end": 78.826,
  "text": "จะเลือกเดินเข้าแม่น้ำ"
 },
 {
  "start": 79.056,
  "end": 80.022,
  "text": "หรือเดินตามผมมา"
 },
 {
  "start": 80.54,
  "end": 81.138,
  "text": "ตับนคุณ"
 },
 {
  "start": 81.428,
  "end": 82.867,
  "text": "คุณจะกล้าเดินเข้าไปในไฟไ"
 },
 {
  "start": 83.227,
  "end": 84.129,
  "text": "คอมมินบาค นดว่า"
 },
 {
  "start": 84.337,
  "end": 85.743,
  "text": "และกดติดตามและแชร์ไว้"
 },
 {
  "start": 86.034,
  "end": 86.565,
  "text": "ตอนหน้า"
 },
 {
  "start": 86.701,
  "end": 87.551,
  "text": "เราจะรู้คำตับ"
 }
]