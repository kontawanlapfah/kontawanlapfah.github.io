[
 {
  "start": 0.0,
  "end": 1.89,
  "text": "ผมไม่กล้าเงินหน้าขึ้นมองท่าน"
 },
 {
  "start": 2.606,
  "end": 3.465,
  "text": "ผมรู้แค่ว่า"
 },
 {
  "start": 3.604,
  "end": 5.203,
  "text": "การทดสอบทั้งหมดที่ผ่านมา"
 },
 {
  "start": 5.421,
  "end": 6.963,
  "text": "มีความหมายในวินาทีนั้น"
 },
 {
  "start": 7.626,
  "end": 9.834,
  "text": "ท่านนบีอิสามาที่ไขของเราจริง ๆ"
 },
 {
  "start": 10.415,
  "end": 11.855,
  "text": "ผู้คนยืนนิ่งเป็นแทว"
 },
 {
  "start": 12.256,
  "end": 14.095,
  "text": "ผมก้มหน้ามองเพื้นตลอดเวลา"
 },
 {
  "start": 14.488,
  "end": 16.287,
  "text": "จับมือฮาวากับซัลมาไว้แน่"
 },
 {
  "start": 16.747,
  "end": 17.955,
  "text": "ท่านเดินผ่านผู้คน"
 },
 {
  "start": 18.247,
  "end": 19.436,
  "text": "รูปใบหน้าของพวกเขา"
 },
 {
  "start": 19.749,
  "end": 22.079,
  "text": "และบอกเล่าถึงระดับชั้นของพวกเขาในส"
 },
 {
  "start": 22.656,
  "end": 24.489,
  "text": "ผมได้ยินเสียงคนรอบตัวสะอื่น"
 },
 {
  "start": 25.054,
  "end": 26.015,
  "text": "ผมเองก็สินกัน"
 },
 {
  "start": 26.603,
  "end": 27.512,
  "text": "แต่ก่อนรุ่งเช้า"
 },
 {
  "start": 27.714,
  "end": 28.812,
  "text": "เข้าใหม่ก็มาถืน"
 },
 {
  "start": 29.214,
  "end": 30.637,
  "text": "อล้าสองจังกับฮันว่า"
 },
 {
  "start": 30.819,
  "end": 32.345,
  "text": "มีบ่าวกลุม 1 ของพระองค์ทุก"
 },
 {
  "start": 32.488,
  "end": 33.095,
  "text": "ปลายอบมาย"
 },
 {
  "start": 33.439,
  "end": 35.406,
  "text": "ไม่มีใครสามารถต่อสู้กับพวกเขาได"
 },
 {
  "start": 35.729,
  "end": 38.085,
  "text": "ให้นำเบาของพระองค์หลบขึ้นประยัง"
 },
 {
  "start": 38.308,
  "end": 39.803,
  "text": "يعجوج لما عجوج"
 },
 {
  "start": 40.389,
  "end": 42.435,
  "text": "ผมเคยคิดว่า การทดสอบจบลงแล้ว"
 },
 {
  "start": 42.76,
  "end": 43.904,
  "text": "แต่ผมพึ่งเข้าใจว่า"
 },
 {
  "start": 44.109,
  "end": 45.303,
  "text": "ตราบใดที่ยังมีชีวิต"
 },
 {
  "start": 45.627,
  "end": 46.876,
  "text": "การทดสอบไม่เคยจบ"
 },
 {
  "start": 47.437,
  "end": 49.702,
  "text": "เราออกเดินทางตามผู้คนขึ้นเขาอีกครั้ง"
 },
 {
  "start": 50.11,
  "end": 51.324,
  "text": "หาริสเดินข้างผม"
 },
 {
  "start": 51.559,
  "end": 53.287,
  "text": "ทองอลกรัฟเบาๆระหว่างทาง."
 },
 {
  "start": 53.661,
  "end": 54.785,
  "text": "ฮาวาดึงมือผม"
 },
 {
  "start": 54.984,
  "end": 56.97,
  "text": "แล้วท่อง 10 อายะแรกให้ฟังจนครบ"
 },
 {
  "start": 57.279,
  "end": 58.319,
  "text": "ไม่ผิดเลยสะคำ"
 },
 {
  "start": 58.746,
  "end": 60.8,
  "text": "ผมวิกถึงข้อความเสียงสุดท้ายข"
 },
 {
  "start": 60.92,
  "end": 62.442,
  "text": "ที่ทำให้ทุกอย่างเริ่มตนคืน"
 },
 {
  "start": 62.817,
  "end": 63.287,
  "text": "สิ่งที่ปก"
 },
 {
  "start": 63.416,
  "end": 64.972,
  "text": "ป้องเราตลอด 40 วันนั้น."
 },
 {
  "start": 65.134,
  "end": 66.059,
  "text": "ไม่ใช่คงว่า มันไม่ใช่ค"
 },
 {
  "start": 66.325,
  "end": 67.002,
  "text": "ไม่ใช่ยา"
 },
 {
  "start": 67.23,
  "end": 68.605,
  "text": "และไม่ใช่ความกล้าของผม"
 },
 {
  "start": 68.922,
  "end": 71.034,
  "text": "แต่คือความรู้ไม่กี่อย่างที่แม่สอน"
 },
 {
  "start": 71.261,
  "end": 72.023,
  "text": "ที่ครูยำ"
 },
 {
  "start": 72.265,
  "end": 73.546,
  "text": "และที่ผมเกือบลืมไป"
 },
 {
  "start": 73.906,
  "end": 74.121,
  "text": "ซิบ"
 },
 {
  "start": 74.261,
  "end": 74.67,
  "text": "อาว"
 },
 {
  "start": 75.04,
  "end": 76.349,
  "text": "ดูอาค่อนห้ายสาลาม"
 },
 {
  "start": 76.572,
  "end": 78.218,
  "text": "และคำเตือนให้อยู่ห่างจากเขา"
 },
 {
  "start": 78.58,
  "end": 79.566,
  "text": "ผมกอดลูกไว้"
 },
 {
  "start": 79.802,
  "end": 82.126,
  "text": "และกระซิบประโยคเดียวกับที่แม่เคยบ"
 },
 {
  "start": 82.613,
  "end": 84.634,
  "text": "พอง 10 อายาแรกของอลกัฟไว้นะลู"
 },
 {
  "start": 85.083,
  "end": 86.162,
  "text": "พอมีดีสอร์เล่นเล่น"
 },
 {
  "start": 86.865,
  "end": 87.35,
  "text": "แล้วคุณล่ะ"
 },
 {
  "start": 87.688,
  "end": 91.17,
  "text": "วันนี้คุณท่อง 10 อายาแรก ของ สูรส อลกรฟ"
 },
 {
  "start": 91.627,
  "end": 93.487,
  "text": "ขอบคุณที่เดินทางไปกับอดัมจน"
 },
 {
  "start": 93.842,
  "end": 95.045,
  "text": "คอมเมนต์ บอกกันด้วยว่"
 },
 {
  "start": 95.171,
  "end": 96.822,
  "text": "ตอนไหนทำให้คุณคลิปมากที่สุด"
 },
 {
  "start": 97.101,
  "end": 98.584,
  "text": "และ Share เรื่องมีให้คนที่คุณรัก"
 },
 {
  "start": 98.809,
  "end": 100.228,
  "text": "เพื่อให้เราเตรียมตัวไปด้วยกั"
 }
]