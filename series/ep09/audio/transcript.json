[
 {
  "start": 0.0,
  "end": 2.053,
  "text": "เพื่อนที่เคยถือรายชื่อคนที่จะถูกจั"
 },
 {
  "start": 2.774,
  "end": 4.777,
  "text": "ตอนนี้นำรองหายอยู่ตรงหน้าผม"
 },
 {
  "start": 5.221,
  "end": 6.806,
  "text": "บนผู้เขาที่ไม่มีอะไรจะกิน"
 },
 {
  "start": 7.542,
  "end": 9.71,
  "text": "ชายที่ตามหาผมคือ Harrest จริง ๆ"
 },
 {
  "start": 10.002,
  "end": 11.001,
  "text": "และเขามาคนเดียว"
 },
 {
  "start": 11.485,
  "end": 12.799,
  "text": "เราเจอเขาที่เชิญเขา"
 },
 {
  "start": 13.163,
  "end": 14.631,
  "text": "เขาผอมจนแทบจำไม่ได้"
 },
 {
  "start": 15.072,
  "end": 16.912,
  "text": "ไม่มีขนมปัง ไม่มียา"
 },
 {
  "start": 17.219,
  "end": 18.222,
  "text": "ไม่มีอะไรเหลือเลย"
 },
 {
  "start": 18.962,
  "end": 19.349,
  "text": "อันน"
 },
 {
  "start": 19.506,
  "end": 20.67,
  "text": "ฉันยืนอยู่ริมแม่น้ำ"
 },
 {
  "start": 21.113,
  "end": 22.039,
  "text": "ควบวดสินหรับ"
 },
 {
  "start": 22.556,
  "end": 23.857,
  "text": "ฉันเห็นแกเดินเข้าไฟ"
 },
 {
  "start": 24.261,
  "end": 26.006,
  "text": "แล้วฉันก็ไม่กลาเก้าไปทางไหนเลย"
 },
 {
  "start": 26.398,
  "end": 27.255,
  "text": "ฉันเลยวิงมี"
 },
 {
  "start": 27.848,
  "end": 28.579,
  "text": "ข่าวคมหน้า"
 },
 {
  "start": 29.154,
  "end": 29.576,
  "text": "พอดรัก"
 },
 {
  "start": 29.801,
  "end": 31.586,
  "text": "ฉันแค่อยากไปดูเขาเท่านั้นเอง อ"
 },
 {
  "start": 31.917,
  "end": 32.415,
  "text": "แค่ดู"
 },
 {
  "start": 33.139,
  "end": 35.354,
  "text": "ผมนึกถึงคําเปือนของใช้ชายาในวั"
 },
 {
  "start": 35.862,
  "end": 36.896,
  "text": "ใครได้ยินข่าวเขา"
 },
 {
  "start": 37.085,
  "end": 37.868,
  "text": "ให้อยู่ ให้ห่าง"
 },
 {
  "start": 38.559,
  "end": 39.328,
  "text": "ผมไม่พูดอะไร"
 },
 {
  "start": 39.63,
  "end": 40.766,
  "text": "แค่ยืนขวดน้ำให้เขา"
 },
 {
  "start": 41.44,
  "end": 43.627,
  "text": "บนฟูกเขาวนั้นมีผู้คนหลายร้อยคน"
 },
 {
  "start": 43.926,
  "end": 45.246,
  "text": "ทุกคนหนีขึ้นมาเหมือนกัน"
 },
 {
  "start": 45.869,
  "end": 48.04,
  "text": "เราแบ่ง Interpol ลำแห่งกันคนละเม็ด 2"
 },
 {
  "start": 48.729,
  "end": 50.949,
  "text": "วันเริ่มกลับมามีความยาวเหมือนป"
 },
 {
  "start": 51.356,
  "end": 53.208,
  "text": "ดวงอาทิตย์ขึ้นและตกตามเวล"
 },
 {
  "start": 53.59,
  "end": 55.973,
  "text": "นาลิกาของผมกลับมาตรงกับท้องฟ้"
 },
 {
  "start": 56.559,
  "end": 59.382,
  "text": "ทุกเย็น ผมสอนหาวาทองอลกรฟทีละอาย"
 },
 {
  "start": 59.752,
  "end": 61.464,
  "text": "และ Harris ความฟังอยู่งีบงียอ"
 },
 {
  "start": 62.098,
  "end": 62.549,
  "text": "วันหนึ่ง"
 },
 {
  "start": 62.794,
  "end": 64.338,
  "text": "ผมได้ยินเขาท่องตามเบาๆ"
 },
 {
  "start": 64.918,
  "end": 65.908,
  "text": "เช้าหมื่อวันนึง"
 },
 {
  "start": 66.243,
  "end": 67.379,
  "text": "ผมตื่นมาละหมาติซุป"
 },
 {
  "start": 67.783,
  "end": 69.218,
  "text": "แล้วมองลงไปทางดามัสกัส"
 },
 {
  "start": 69.59,
  "end": 70.992,
  "text": "ทางฝั่งตะวันออของเมือง"
 },
 {
  "start": 71.216,
  "end": 74.643,
  "text": "มีแสงสว่างนวนประกฎขึ้นตรงหออาศาลส"
 },
 {
  "start": 75.027,
  "end": 76.3,
  "text": "ทั้งที่ทั้งเมืองมืดเสน็จ"
 },
 {
  "start": 76.885,
  "end": 79.165,
  "text": "ผู้คนรอบตัวผมลุกขึ้นยืนทีละคน"
 },
 {
  "start": 79.512,
  "end": 80.646,
  "text": "ไม่นี่ใครพูดอะไรเลย"
 },
 {
  "start": 81.365,
  "end": 82.418,
  "text": "แสนนั้นคืออะไร"
 },
 {
  "start": 82.998,
  "end": 83.686,
  "text": "และ 9 จุด"
 },
 {
  "start": 83.822,
  "end": 83.919,
  "text": "จบ"
 },
 {
  "start": 84.056,
  "end": 85.076,
  "text": "ของความหวาดกลัว"
 },
 {
  "start": 85.606,
  "end": 86.828,
  "text": "หรือการทดสอบครั้งใหม่"
 },
 {
  "start": 87.538,
  "end": 89.606,
  "text": "คุณคิดว่าแสงที่หออสารนั้นคือ"
 },
 {
  "start": 89.953,
  "end": 90.862,
  "text": "คอมเมนต์บอกกันด้วย"
 },
 {
  "start": 91.135,
  "end": 91.55,
  "text": "ละกอติด"
 },
 {
  "start": 91.674,
  "end": 92.533,
  "text": "ตามแล้วช่าวไหว"
 },
 {
  "start": 92.965,
  "end": 95.246,
  "text": "ตอนหน้าคือเช้าที่ทุกคนรอคอย"
 }
]