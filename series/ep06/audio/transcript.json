 },
 {
  "start": 27.359,
  "end": 28.049,
  "text": "คาฟิร"
 },
 {
  "start": 28.761,
  "end": 31.116,
  "text": "ผู้คนข้างล่างยังหัวร้องสรรเสริญเข"
 },
 {
  "start": 31.457,
  "end": 33.075,
  "text": "ราวกับไม่มีใครเห็นอะไรเลย"
 },
 {
  "start": 33.796,
  "end": 34.484,
  "text": "แล้วเสียนเล็กเล็ก"
 },
 {
  "start": 34.639,
  "end": 35.794,
  "text": "ก็ดังคืนข้างหลังผม"
 },
 {
  "start": 36.666,
  "end": 38.834,
  "text": "หวาปีนบรรดัยตามขึ้นมาตอนไหนไม่"
 },
 {
  "start": 39.557,
  "end": 40.022,
  "text": "爸爸"
 },
 {
  "start": 40.554,
  "end": 41.616,
  "text": "หน้าผ่าเขาเขียนว่า"
 },
 {
  "start": 41.877,
  "end": 42.389,
  "text": "kafir"
 },
 {
  "start": 43.064,
  "end": 43.983,
  "text": "ผมหันไปมองลูก"
 },
 {
  "start": 44.492,
  "end": 46.843,
  "text": "หาวายังอ่านนั้นสือไม่ออกแม้แต่คำ"
 },
 {
  "start": 47.42,
  "end": 48.539,
  "text": "ผมดึงลูกเข้ามาก่อน"
 },
 {
  "start": 48.876,
  "end": 50.233,
  "text": "เริ่มนึกถึงคำสอนที่ว่า"
 },
 {
  "start": 50.713,
  "end": 52.782,
  "text": "พระผู้อภิบาลของเราไม่ได้ตาบอด"
 },
 {
  "start": 53.491,
  "end": 55.925,
  "text": "ความกลัวในใจผมเปลี่ยนเป็นความมั่นใ"
 },
 {
  "start": 56.435,
  "end": 58.693,
  "text": "ผมรู้แล้วว่าตัวเองกำลังมองใครอยู่"
 },
 {
  "start": 59.343,
  "end": 60.683,
  "text": "ชายคนนั้นยิ้มมุมปาก"
 },
 {
  "start": 60.925,
  "end": 62.869,
  "text": "แล้วหันหลังเดินต่อไปพร้อมขบ"
 },
 {
  "start": 63.492,
  "end": 63.803,
  "text": "ตัวดีบ"
 },
 {
  "start": 64.243,
  "end": 65.705,
  "text": "มีเสียงทุกประตูดังสนัน."
 },
 {
  "start": 66.082,
  "end": 67.97,
  "text": "ถหารของเขาเดินไล่เขาอีกทีลบ้"
 },
 {
  "start": 68.227,
  "end": 70.26,
  "text": "พร้อมรายชื่อของคนที่ไม่ยองออกไปต้"
 },
 {
  "start": 70.91,
  "end": 71.998,
  "text": "ผมแง้มหน้าต่างดู"
 },
 {
  "start": 72.338,
  "end": 73.421,
  "text": "และหัวใจผมแทบหยุด"
 },
 {
  "start": 73.569,
  "end": 73.784,
  "text": "ตัน"
 },
 {
  "start": 74.387,
  "end": 76.459,
  "text": "คนที่ยืนถือรายเชื่ออยู่หน้าบ้านผม"
 },
 {
  "start": 76.804,
  "end": 77.484,
  "text": "ควหารส"
 },
 {
  "start": 78.037,
  "end": 80.01,
  "text": "หาริสพาพวกเขามาจับผมจริงๆ หรื"
 },
 {
  "start": 80.549,
  "end": 81.744,
  "text": "แล้วคนที่ไม่ยอมรับเขาแล้ว"
 },
 {
  "start": 81.908,
  "end": 82.899,
  "text": "จะถูกพาไปที่ไหน"
 },
 {
  "start": 83.577,
  "end": 85.562,
  "text": "คุณคิดว่าหาริสหักหลังอดำจ"
 },
 {
  "start": 85.939,
  "end": 86.812,
  "text": "ขอมมินบอกในด้วย"
 },
 {
  "start": 86.991,
  "end": 88.351,
  "text": "และกดติดตามและแชร์ไว้"
 },
 {
  "start": 88.781,
  "end": 91.361,
  "text": "ตอนหน้าคือบททธสอบที่ร้อนแรงที่สุ"
