[
 {
  "start": 0.278,
  "end": 1.985,
  "text": "ลูกสาวผมเล่งอ่านทั้งสือไม่อ"
 },
 {
  "start": 2.831,
  "end": 3.479,
  "text": "ตาวันนั้น"
 },
 {
  "start": 3.797,
  "end": 5.624,
  "text": "เธออ่านคำบนหน้าผ่าของเขาได้"
 },
 {
  "start": 6.286,
  "end": 7.502,
  "text": "ของหน่อยหน้าขึ้นมา"
 },
 {
  "start": 7.752,
  "end": 9.638,
  "text": "และผมได้เห็นใบหน้านั้นเต็มตา"
 },
 {
  "start": 10.347,
  "end": 12.655,
  "text": "ตาข้างขวาของเขาบอดและนูนออกมา"
 },
 {
  "start": 13.107,
  "end": 14.577,
  "text": "เหมือนเมล็ดอังหุ่นที่ลอยอย"
 },
 {
  "start": 15.358,
  "end": 15.477,
  "text": "ตัว"
 },
 {
  "start": 15.601,
  "end": 17.848,
  "text": "อย่างตรงกับที่ผมเคยได้ยิมมาตั้งแต่เด"
 },
 {
  "start": 18.595,
  "end": 20.023,
  "text": "และระหว่างดวงตาทั้งสอง"
 },
 {
  "start": 20.376,
  "end": 21.714,
  "text": "มีอักษร 3 ตัวชัด"
 },
 {
  "start": 21.866,
  "end": 23.409,
  "text": "เจนร่าวกับถูกสลักไว้"
 },
 {
  "start": 24.32,
