[
 {
  "start": 0.19,
  "end": 2.027,
  "text": "ฝนไม่ตกที่นี่มาเจ็ดเดือแล้ว"
 },
 {
  "start": 2.649,
  "end": 3.257,
  "text": "คุณี"
 },
 {
  "start": 3.674,
  "end": 4.802,
  "text": "พร้อม ผมไปลังเข้ามา"
 },
 {
  "start": 5.148,
  "end": 6.154,
  "text": "ทั้งตัวเปียกโชค"
 },
 {
  "start": 6.872,
  "end": 7.68,
  "text": "ผมชื่ออดัม"
 },
 {
  "start": 7.904,
  "end": 8.589,
  "text": "อาว อาว อาว อาว"
 },
 {
  "start": 9.062,
  "end": 12.05,
  "text": "เป็นนักศึกษาไทยที่มาเรียนภาษาอา"
 },
 {
  "start": 12.604,
  "end": 14.773,
  "text": "ผมอยู่ที่นี่กับ Salma ภรยาของผม"
 },
 {
  "start": 15.032,
  "end": 16.834,
  "text": "ลหาว่าลุกษาวัย 5 ขวบ"
 },
 {
  "start": 17.406,
  "end": 18.699,
  "text": "ช่วงนี้มีข่าวลืบและกว่"
 },
 {
  "start": 18.826,
  "end": 20.148,
  "text": "เปล่ากรอยมาจากทางตะวันออก"
 },
 {
  "start": 20.652,
  "end": 22.814,
  "text": "คนพูดถึงชายคนหนึ่งที่ตาข้างหนึ่ง"
 },
 {
  "start": 23.102,
  "end": 24.886,
  "text": "แต่ทำเรื่องที่ไม่นี่ใครอธิบายได้"
 },
 {
  "start": 25.365,
  "end": 26.973,
  "text": "คลิปของเขาทุกช่า กันทั้งเม"
 },
 {
  "start": 27.273,
  "end": 28.292,
  "text": "บางคนหัวรออยออก"
 },
 {
  "start": 28.63,
  "end": 29.759,
  "text": "บางคนนั่งรองหาย"
 },
 {
  "start": 30.253,
  "end": 31.503,
  "text": "ผมพยายามไม่สนใจ"
 },
 {
  "start": 31.857,
  "end": 34.071,
  "text": "แต่ข้อความเสียงสุดท้ายของแม่จาก"
 },
 {
  "start": 34.198,
  "end": 35.334,
  "text": "ยังวนอยู่ในหัวผม"
 },
 {
  "start": 35.882,
  "end": 36.374,
  "text": "Adam"
 },
 {
  "start": 36.715,
  "end": 39.092,
  "text": "พอง 10 อายาแรก ของ สูรส อลกฟี"
 },
 {
  "start": 39.479,
  "end": 40.539,
  "text": "แม่มีรีสอร์ลิลเล่น"
 },
 {
  "start": 41.126,
  "end": 41.926,
  "text": "หลังจากวันนั้น"
 },
 {
  "start": 42.124,
  "end": 44.1,
  "text": "สัญญาณทราศัพท์ก็ไม่เคยกลั"
 },
 {
  "start": 44.633,
  "end": 47.113,
  "text": "คืนนี้ผมเปิดมุสหัฟเล่มเล็กที่แม่ให"
 },
 {
  "start": 47.363,
  "end": 49.26,
  "text": "แล้วก็ต้องยอมรับความจริงที่หน้"
 },
 {
  "start": 49.762,
  "end": 51.454,
  "text": "ผมจำได้แค่ 3 อายาเท่านั้น"
 },
 {
  "start": 51.928,
  "end": 53.586,
  "text": "ผมท้องสำไปสำมา"
 },
 {
  "start": 53.716,
  "end": 55.574,
  "text": "จนฮาว่าหลับไปบนตักของซามา"
 },
 {
  "start": 56.183,
  "end": 57.692,
  "text": "และเสียงคอบประตูก็ดังขึ้"
 },
 {
  "start": 58.096,
  "end": 58.761,
  "text": "3ครั้ง"
 },
 {
  "start": 59.205,
  "end": 59.75,
  "text": "ชาชา"
 },
 {
  "start": 60.472,
  "end": 62.098,
  "text": "คนที่ยืนอยู่หน้าบ้านคือหาริส"
 },
 {
  "start": 62.354,
  "end": 64.53,
  "text": "เพื่อนสนิตที่หายไปทางตะวันออกเมื่อ"
 },
 {
  "start": 64.906,
  "end": 66.124,
  "text": "เสื้อของเขาเปลียกโชค"
 },
 {
  "start": 66.488,
  "end": 68.656,
  "text": "ในมือถือขนมปังอุ่นๆ ทรงกล"
 },
 {
  "start": 68.963,
  "end": 71.953,
  "text": "ทางที่เมืองนี้ ไม่มีใครเห็นขนมปังสดๆ"
 },
 {
  "start": 72.39,
  "end": 73.192,
  "text": "ก็อแมนที่บน"
 },
 {
  "start": 73.609,
  "end": 76.13,
  "text": "แต่แววตา ไม่ใช่หาริสค์คนเดิมที่ผมรู้"
 },
 {
  "start": 76.587,
  "end": 77.439,
  "text": "ที่มูบάνผม"
 },
 {
  "start": 77.578,
  "end": 78.682,
  "text": "ฝนตกแล้วนะอาดำ"
 },
 {
  "start": 79.037,
  "end": 79.495,
  "text": "โคลกรสิบ"
 },
 {
  "start": 79.934,
  "end": 81.158,
  "text": "พลักควสังไอฟาตก"
 },
 {
  "start": 81.617,
  "end": 83.077,
  "text": "ผมมองขนมปังในมือเพื่อน"
 },
 {
  "start": 83.246,
  "end": 85.608,
  "text": "แล้วหันไปมองลูกสาวที่ไม่ได้กินอิ"
 },
 {
  "start": 86.066,
  "end": 87.742,
  "text": "ผมควรรับขนมปังก้อนนั้นไว้"
 },
 {
  "start": 88.016,
  "end": 89.856,
  "text": "หรือคนปิดประตูใส่เพื่อนที่รัก"
 },
 {
  "start": 90.338,
  "end": 90.703,
  "text": "ล้อ"
 },
 {
  "start": 90.974,
  "end": 92.584,
  "text": "คาวที่หลับสบุทธ"
 },
 {
  "start": 92.864,
  "end": 93.591,
  "text": "คือใครกันนะ"
 },
 {
  "start": 94.138,
  "end": 94.74,
  "text": "ตับนคุณ"
 },
 {
  "start": 94.994,
  "end": 96.411,
  "text": "คุณจะรับขนมปังก้อนนั้นไหม"
 },
 {
  "start": 96.751,
  "end": 97.657,
  "text": "คอมเมนต์บอกกันด้วย"
 },
 {
  "start": 97.906,
  "end": 101.084,
  "text": "และอย่าลืมกดติดตามและ Share เรื่องนี้เพื่อไม่ให้"
 }
]