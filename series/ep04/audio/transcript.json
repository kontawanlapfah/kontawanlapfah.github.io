[
 {
  "start": 0.212,
  "end": 2.198,
  "text": "บ้านฝั่งตรงค้ามมีน้ำพูมสวน"
 },
 {
  "start": 2.761,
  "end": 3.537,
  "text": "ส่วนบ้านผม"
 },
 {
  "start": 3.813,
  "end": 5.526,
  "text": "ไม่มีน้ำ แม้แต่จะเช็ดตัวให"
 },
 {
  "start": 6.16,
  "end": 7.299,
  "text": "ฝนไม่ได้ตกแบบสุม ฝน"
 },
 {
  "start": 7.732,
  "end": 10.157,
  "text": "มันตกเฉพาะบ้านของคนที่เดินทางไปทางต"
 },
 {
  "start": 10.501,
  "end": 11.363,
  "text": "ไปหาเขา"
 },
 {
  "start": 11.518,
  "end": 12.739,
  "text": "มันมันมันมีความความค"
 },
 {
  "start": 13.022,
  "end": 13.797,
  "text": "เราเชื่อแล้ว"
 },
 {
  "start": 14.238,
  "end": 16.777,
  "text": "เพียงไม่กีวัน สวันของพูขาวกะขี"
 },
 {
  "start": 17.238,
  "end": 20.042,
  "text": "แพ้ของเพื่อนบ้านกลับมาตัวอ่วนมีนมเต"
 },
 {
  "start": 20.48,
  "end": 21.833,
  "text": "ส่วนบ้านของคนที่ปฏิเศษ"
 },
 {
  "start": 22.226,
  "end": 24.054,
  "text": "ทุกอย่างแห้งตายลงมันโดนสาบ"
 },
 {
  "start": 24.593,
  "end": 26.165,
  "text": "วันอันยาวนานนั้นผ่านไป"
 },
 {
  "start": 26.423,
  "end": 28.062,
  "text": "ตามด้วยวันที่ยาวเท่าหนึ่งเด"
 },
 {
  "start": 28.503,
  "end": 29.804,
  "text": "นาฬิกาผมบอกว่า"
 },
 {
  "start": 30.038,
  "end": 31.54,
  "text": "เราอดอยากกันมาหลายเดือนแล้ว"
 },
 {
  "start": 31.947,
  "end": 35.058,
  "text": "ซาลมาใช้ผ้าชุบน้ำก้นขวดสุดท้ายเช็ด"
 },
 {
  "start": 35.436,
  "end": 37.183,
  "text": "น้ำในขวดของผมเหลือไม่ถึงครึ่"
 },
 {
  "start": 37.599,
  "end": 39.181,
  "text": "ผมเริ่มได้ยินเสียงในหัวตัว"
 },
 {
  "start": 39.626,
  "end": 40.688,
  "text": "เธอคอบคุณควร"
 },
 {
  "start": 41.117,
  "end": 43.121,
  "text": "ทำไมพระเจ้าถึงปล่อยให้เขาทำแบบน"
 },
 {
  "start": 43.603,
  "end": 44.785,
  "text": "แล้วผมก็นึกขึ้นได้ว่า"
 },
 {
  "start": 45.037,
  "end": 46.318,
  "text": "ชัยยะอย่าเคยบอกว่า"
 },
 {
  "start": 46.6,
  "end": 47.795,
  "text": "นี่แหละคือการทดสอบ"
 },
 {
  "start": 48.194,
  "end": 48.866,
  "text": "ทมันงาย"
 },
 {
  "start": 49.064,
  "end": 49.936,
  "text": "มันก็ไม่ใช่ fit นะ"
 },
 {
  "start": 50.31,
  "end": 54.924,
  "text": "ผมจึงละมาต์ตามเวลาที่จดไว้บนกำแพง และขอความคุ้"
 },
 {
  "start": 55.334,
  "end": 57.082,
  "text": "คือนนั้น Harrest กลับมาอีกครั้ง"
 },
 {
  "start": 57.499,
  "end": 59.388,
  "text": "คราวนี้ในมือของเขาไม่ใช่ขนมปั"
 },
 {
  "start": 59.666,
  "end": 60.823,
  "text": "แต่เป็นกล่องยาลดไข่"
 },
 {
  "start": 61.243,
  "end": 62.898,
  "text": "ฉันไม่ได้มาบังคับแกนะอดัม"
 },
 {
  "start": 63.216,
  "end": 64.088,
  "text": "คาปุทยองสัน"
 },
 {
  "start": 64.417,
  "end": 65.733,
  "text": "พรุมมีเขาจะเข้าเมื่อมี"
 },
 {
  "start": 66.034,
  "end": 67.156,
  "text": "แกแค่ไปดูเขาก็พอ"
 },
 {
  "start": 67.341,
  "end": 68.25,
  "text": "ไม่ต้องเชื่ออะไรเลย"
 },
 {
  "start": 68.539,
  "end": 69.931,
  "text": "แล้วอย่านี้ก็เป็นของฮาวา"
 },
 {
  "start": 70.271,
  "end": 71.073,
  "text": "พบมจะยอมมี"
 },
 {
  "start": 71.35,
  "end": 72.008,
  "text": "ความวิธี ที่นี่ ท"
 },
 {
  "start": 72.271,
  "end": 74.364,
  "text": "เพื่อแรกกับยาที่อาจช่วยชีวิตล"
 },
 {
  "start": 74.77,
  "end": 75.397,
  "text": "และพรุงนี้"
 },
 {
  "start": 75.543,
  "end": 76.411,
  "text": "มือเขามาถึงมื้อง"
 },
 {
  "start": 76.759,
  "end": 77.573,
  "text": "อะไรจะเกิดขึ้น?"
 },
 {
  "start": 77.957,
  "end": 78.869,
  "text": "ทักคุณเป็นอดัม"
 },
 {
  "start": 79.104,
  "end": 80.294,
  "text": "คุณจะรับอยากหล่องนั้นไหม"
 },
 {
  "start": 80.671,
  "end": 81.58,
  "text": "คอมเมนต์ บอกกันด้วย"
 },
 {
  "start": 81.775,
  "end": 83.173,
  "text": "และกดติดตามและแชร์ไว้"
 },
 {
  "start": 83.511,
  "end": 84.035,
  "text": "พรุงนิ"
 },
 {
  "start": 84.196,
  "end": 85.352,
  "text": "ทั้งเมืองจะเปลี่ยนไป"
 }
]